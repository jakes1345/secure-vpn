# PhazeVPN Environment Configuration
# Copy this to .env and fill in your values
# DO NOT commit .env to version control

# Server
APP_HOST=localhost
APP_PORT=5000
APP_SECRET=<generate-with-openssl-rand-hex-32>
GIN_MODE=debug

# VPN Server
VPN_SERVER_HOST=localhost
VPN_SERVER_ENDPOINT=localhost:51820
VPN_OPENVPN_ENDPOINT=localhost:1194
VPN_PHAZE_ENDPOINT=localhost:51821
VPN_DNS_SERVERS=1.1.1.1,1.0.0.1

# WireGuard
WG_SERVER_PUBLIC_KEY=<your-wireguard-server-public-key>

# API URL (for GUI client)
VPN_API_URL=http://localhost:5000

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=admin@localhost
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM_EMAIL=noreply@localhost

# Database
DB_PATH=./phazevpn.db
